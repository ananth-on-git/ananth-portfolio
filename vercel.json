{
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/public/Anantha_Sai_Resume_CSM_2026.pdf",
      "headers": {
        "Content-Disposition": "attachment; filename=\"Anantha_Sai_Resume.pdf\"",
        "Content-Type": "application/pdf"
      },
      "continue": true
    },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
